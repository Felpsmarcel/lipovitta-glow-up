            },
            "include_tests": {
              "type": "boolean",
              "default": false,
              "description": "Incluir pedidos de teste."
            },
            "only_mismatches": {
              "type": "boolean",
              "default": false,
              "description": "Mostrar apenas pedidos com divergência de preço."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_abandoned_checkouts",
        "title": "Listar carrinhos abandonados",
        "description": "Lista os carrinhos abandonados capturados pelo webhook da Yampi: nome, telefone, e-mail, produtos, valor, UTMs, links de recuperação/recompra e data. Contém dados pessoais — apenas administradores conseguem ler.",
        "annotations": {
