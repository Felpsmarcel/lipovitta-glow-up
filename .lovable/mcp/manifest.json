            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50,
              "description": "Máximo de linhas."
            },
            "only_unrecovered": {
              "type": "boolean",
              "default": true,
              "description": "Mostrar apenas carrinhos ainda não recuperados."
            }
